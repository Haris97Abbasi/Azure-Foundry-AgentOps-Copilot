<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentOpsCopilot</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runbooks and mock data are read at runtime from the output directory. -->
    <None Update="Knowledge\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Conversation memory is runtime state, never shipped with the build. -->
    <None Update="Data\session.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
