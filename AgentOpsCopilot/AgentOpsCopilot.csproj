<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentOpsCopilot</RootNamespace>
    <UserSecretsId>a51bad7d-f20a-4024-bedc-5d5fd066841a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Settings, runbooks and mock data are read at runtime from the output directory. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Knowledge\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Conversation memory is runtime state, never shipped with the build. -->
    <None Update="Data\session.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

</Project>
